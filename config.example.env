# VtAtlas listens on loopback by default.
VTV_HOST=127.0.0.1
VTV_PORT=17888

# Local Vitess control plane. Change paths and ports for your installation.
VTV_VTCTLDCLIENT=/opt/vitess/current/bin/vtctldclient
VTV_VTCTLD_ADDRESS=127.0.0.1:15999
# Optional: VtAtlas can inspect exported, non-secret hints in your start script.
VTV_START_SCRIPT=
VTV_ETCD_PATH=/opt/vitess/etcd/etcd

# Optional official VTAdmin integration. Uncomment after starting VTAdmin.
# VTV_VTADMIN_API=http://127.0.0.1:14200
VTV_VTADMIN_LOCAL_CLUSTER_ID=local
VTV_MANAGED_CLUSTER_FILE=./var/managed-clusters.json
VTA_CLUSTER_CONFIG=./vtadmin/clusters.json
VTA_MANAGED_CLUSTER_CONFIG=./var/managed-clusters.json
VTA_API_BIND=127.0.0.1:14200
VTA_WEB_HOST=127.0.0.1
VTA_WEB_PORT=14201
VTA_API_ADDRESS=http://127.0.0.1:14200
VTA_WEB_BUILD=/opt/vitess/current/web/vtadmin/build
# Optional: used only when a discovery endpoint contains {{HOST_IP}}.
VTA_HOST_IP=

# Every external read is bounded. Values are milliseconds.
VTV_COMMAND_TIMEOUT_MS=4000
VTV_HTTP_TIMEOUT_MS=2500
VTV_CACHE_MAX_AGE_MS=300000
VTV_REFRESH_INTERVAL_MS=15000

# App-owned files only. VtAtlas never writes to Vitess, MySQL, or the topology service.
VTV_CACHE_FILE=./var/last-good.json
