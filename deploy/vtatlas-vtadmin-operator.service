[Unit]
Description=VTAdmin API for VtAtlas Operator (limited write RBAC)
Documentation=https://github.com/ohjinsol77/VtAtlas
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vitess
Group=vitess
WorkingDirectory=/opt/vtatlas
EnvironmentFile=-/etc/vtatlas/vtatlas.env
Environment=VTA_API_BIND=127.0.0.1:14202
Environment=VTA_RBAC_CONFIG=/opt/vtatlas/vtadmin/rbac-dba.yaml
ExecStart=/usr/bin/node /opt/vtatlas/vtadmin/launcher.mjs
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/vtatlas/var
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
